PORT=3001
NODE_ENV=production

# ==============================================================================
# OPÇÃO 1: Sincronização Local (Cliente com ERP na mesma rede / máquina)
# ==============================================================================
# Caminho absoluto ou relativo da pasta onde o ERP grava os arquivos PBI_*.zip
# Exemplos Windows: "C:/Consuldata/PBI" ou "D:/ERP/PBI" ou "//SERVIDOR/PBI_Export"
LOCAL_PBI_DIR="C:/Consuldata/PBI"

# Intervalo da varredura periódica de novos arquivos em minutos (o file watcher em tempo real também fica ativo)
SYNC_INTERVAL_MINUTES=5

# ==============================================================================
# OPÇÃO 2: Sincronização Remota via FTP (Opcional se usar LOCAL_PBI_DIR)
# ==============================================================================
# FTP_HOST=ftp.consuldatasistemas.com.br
# FTP_PORT=21
# FTP_USER=consuldata
# FTP_PASSWORD="sua_senha_aqui"
# FTP_DIR=clientes/nome_do_cliente

