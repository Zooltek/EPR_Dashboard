# ==========================================
# Amura Dashboard — Variáveis de Ambiente
# ==========================================

# Configurações do Servidor
PORT=3001
NODE_ENV=production
LOCAL_PBI_DIR=./PBI
EPR_DATA_DIR=./server/data

# Provedor FTP VixHost (Consuldata)
FTP_VIXHOST_HOST=ftp.consuldatasistemas.com.br
FTP_VIXHOST_PORT=21
FTP_VIXHOST_USER=consuldata
FTP_VIXHOST_PASSWORD=sua_senha_aqui

# Provedor FTP UOLHost (Plenus)
FTP_UOLHOST_HOST=ftp.sistemaplenus.com.br
FTP_UOLHOST_PORT=21
FTP_UOLHOST_USER=sistemaplenus
FTP_UOLHOST_PASSWORD=sua_senha_aqui

# Pasta padrão do cliente no FTP (ex: cliente/nome_do_cliente)
FTP_DEFAULT_CLIENT_FOLDER=cliente_padrao
