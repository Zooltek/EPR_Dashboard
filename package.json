{
  "name": "amura-dashboard",
  "version": "1.0.0",
  "description": "Amura Dashboard - Gestão e Inteligência Multilojas",
  "main": "desktop/main.js",
  "scripts": {
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build:all": "npm run build:client && npm run build:server",
    "desktop:start": "electron .",
    "desktop:dev": "npm run build:all && electron .",
    "desktop:dist": "npm run build:all && node build_wrapper.js && electron-builder --win nsis"
  },
  "keywords": [
    "amura",
    "dashboard",
    "varejo",
    "multilojas",
    "electron"
  ],
  "author": "Zooltek",
  "license": "ISC",
  "build": {
    "appId": "com.zooltek.amuradashboard",
    "productName": "Amura Dashboard",
    "copyright": "Copyright © 2026 Zooltek",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "desktop/**/*",
      "server/dist/**/*",
      "server/package.json",
      "client/dist/**/*",
      "PBI/**/*",
      "Logo Amura.png"
    ],
    "extraResources": [
      {
        "from": "PBI",
        "to": "PBI",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Amura Dashboard"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "basic-ftp": "^5.0.5",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "jszip": "^3.10.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.1",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  }
}
