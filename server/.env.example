PORT=3001
NODE_ENV=development

# ==============================================================================
# OPÇÃO 1: Sincronização Local (Cliente com ERP na mesma rede / máquina)
# ==============================================================================
# Caminho da pasta onde o ERP grava os arquivos PBI_*.zip
# Exemplos: "C:/Consuldata/PBI" ou "../PBI"
LOCAL_PBI_DIR="../PBI"

# Intervalo da varredura periódica em minutos
SYNC_INTERVAL_MINUTES=5

# ==============================================================================
# OPÇÃO 2: Sincronização Remota via FTP (Opcional)
# ==============================================================================
# FTP_HOST=ftp.consuldatasistemas.com.br
# FTP_PORT=21
# FTP_USER=usuario_ftp
# FTP_PASSWORD="sua_senha_aqui"
# FTP_DIR=/clientes/nome_do_cliente

